APP_NAME=INOTEK
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# APP_VERSION overrides the version shown in the UI (default in config/app.php)
# APP_VERSION=
APP_TIMEZONE=Asia/Kuala_Lumpur

# Required only when the first admin account is provisioned by seeding outside local/testing.
# Supply secrets through the deployment environment; do not commit them to this file.
# INOTEK_BOOTSTRAP_ADMIN_EMAIL=
# INOTEK_BOOTSTRAP_ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Production: LOG_STACK=daily, LOG_DAILY_DAYS=30, LOG_LEVEL=warning
LOG_STACK=single
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inotek
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_TABLE=laravel_sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS). Keep false for plain-HTTP local setups.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
# Enable after installing/configuring Laravel Reverb for real-time delivery:
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=local
# REVERB_APP_KEY=local
# REVERB_APP_SECRET=local
# REVERB_HOST=127.0.0.1
# REVERB_PORT=8080
# REVERB_SCHEME=http
# VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# VITE_REVERB_HOST="${REVERB_HOST}"
# VITE_REVERB_PORT="${REVERB_PORT}"
# VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
